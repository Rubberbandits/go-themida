[SECURE_ENGINE]
; retained comment
SOFTWARE_NAME=Sample
INPUT_FILE_NAME=%PROJECT_FOLDER%\app.exe
OUTPUT_FILE_NAME=protected.exe
OPTION_PROTECTION_IS_ANTIDEBUG=true
OPTION_FUTURE_DATA= value=with=equals 
OPTION_MACROS_MAP_FUNCTIONS_NUMBER=2
OPTION_MACROS_MAP_FUNCTION_NAME_AT_0=zeta
OPTION_MACROS_MAP_FUNCTION_TYPE_AT_0=0x0000000A
OPTION_MACROS_MAP_FUNCTION_NAME_AT_1=alpha
OPTION_MACROS_MAP_FUNCTION_TYPE_AT_1=16
OPTION_MACROS_DISABLE_AT_RVA_NUMBER=3
MSG_ID_DEBUGGER_ICON=ERROR
MSG_ID_DEBUGGER_IS_ENABLED=true
MSG_ID_DEBUGGER_NUMBER_LANGUAGES=2
MSG_ID_DEBUGGER_LANGUAGE_0_ID=[DEFAULT]
MSG_ID_DEBUGGER_LANGUAGE_0_TEXT=Hello\nworld
MSG_ID_DEBUGGER_LANGUAGE_1_ID=ENGLISH
MSG_ID_DEBUGGER_LANGUAGE_1_TEXT=English text
OPTION_XBUNDLER_NUMBER_FILES=1
OPTION_XBUNDLER_FILE_NAME_AT_0=%PROJECT_FOLDER%\module.dll
OPTION_XBUNDLER_FILE_TYPE_AT_0=EXTRACT_NEVER
OPTION_XBUNDLER_FILE_VIRTUAL_PATH_AT_0=%APP_FOLDER%\module.dll
OPTION_XBUNDLER_IS_ENABLED=true
